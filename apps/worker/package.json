{
  "name": "@mae/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply memecoin-analysis-engine --local",
    "db:migrate:remote": "wrangler d1 migrations apply memecoin-analysis-engine --remote"
  },
  "dependencies": {
    "@mae/core": "workspace:*",
    "@mae/providers": "workspace:*",
    "hono": "^4.6.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
